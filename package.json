{
    "private": true,
    "type": "module",
    "scripts": {
        "build": "php artisan wayfinder:generate --no-interaction && vite build",
        "dev": "vite",
        "lint": "npm run lint:eslint && npm run lint:prettier && npm run typecheck",
        "lint:eslint": "eslint resources/js vite.config.ts --max-warnings=0",
        "lint:prettier": "prettier --check \"resources/**/*.{ts,vue,css}\" vite.config.ts tsconfig.json tsconfig.node.json eslint.config.mjs prettier.config.mjs",
        "pretypecheck": "php artisan wayfinder:generate --no-interaction",
        "typecheck": "vue-tsc --noEmit -p tsconfig.json && npm run typecheck:native",
        "pretypecheck:incremental": "php artisan wayfinder:generate --no-interaction",
        "typecheck:incremental": "vue-tsc --noEmit --incremental --tsBuildInfoFile node_modules/.vue-tsc.tsbuildinfo -p tsconfig.json && npm run typecheck:native",
        "audit": "npm audit --audit-level=high",
        "qa": "npm run lint && npm run build && npm run audit",
        "typecheck:native": "tsc --noEmit -p tsconfig.node.json"
    },
    "dependencies": {
        "@blade-flags/core": "^0.3.0",
        "@inertiajs/vue3": "^3.11.0",
        "@lucide/vue": "^1.66.0",
        "@primeuix/themes": "^2.0.3",
        "@vueuse/core": "^15",
        "chokidar": "^5.0.0",
        "laravel-vue-i18n": "^2.9.0",
        "primevue": "^4.4.0",
        "vue": "^3.5.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@laravel/vite-plugin-wayfinder": "^0.1.11",
        "@tailwindcss/vite": "^4.3.4",
        "@types/node": "^26.6.6",
        "@vitejs/plugin-vue": "^6.0.10",
        "eslint-config-prettier": "^10.1.0",
        "eslint-plugin-vue": "^10.12.0",
        "globals": "^17.14.0",
        "laravel-vite-plugin": "^3.2.0",
        "prettier": "^3.9.10",
        "tailwindcss": "^4.0.0",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "^8.31.0",
        "vite": "^8.3.0",
        "vue-eslint-parser": "^10.4.1",
        "vue-tsc": "^3.3.14",
        "@typescript/native": "npm:typescript@^7.0.2"
    }
}
